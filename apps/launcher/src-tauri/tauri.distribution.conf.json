{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zivra Distribution System",
  "identifier": "com.platform.distribution",
  "version": "1.0.1",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zivra Distribution System"
      }
    ]
  },
  "bundle": {
    "shortDescription": "Wholesale & distribution by BARIQ ERP Solutions",
    "longDescription": "Zivra Distribution System by BARIQ ERP Solutions — order booking, trade customers, deliveries, collections, field force, and territory/PJP.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/basir2353/zivra-distribution-updates/releases/latest/download/latest-distribution.json"
      ]
    }
  }
}
