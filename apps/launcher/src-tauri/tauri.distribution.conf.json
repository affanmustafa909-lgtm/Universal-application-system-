{

  "$schema": "https://schema.tauri.app/config/2",

  "productName": "Medical Distribution System",

  "identifier": "com.platform.distribution",

  "version": "0.3.60",

  "app": {

    "windows": [

      {

        "label": "main",

        "title": "Medical Distribution System"

      }

    ]

