{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zivra Restaurant Management System",
  "identifier": "com.platform.restaurant",
  "version": "1.0.2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zivra Restaurant Management System"
      }
    ]
  },
  "bundle": {
    "shortDescription": "Restaurant POS & ERP by BARIQ ERP Solutions",
    "longDescription": "Zivra Restaurant Management System by BARIQ ERP Solutions — POS, kitchen, tables, menu, inventory, HR, and accounting.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/basir2353/zivra-desktop-updates/releases/latest/download/latest-restaurant.json"
      ]
    }
  }
}
