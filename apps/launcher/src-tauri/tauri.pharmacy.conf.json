{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zivra Pharmacy Management System",
  "identifier": "com.platform.pharmacy",
  "version": "1.0.2",
  "app": {
    "windows": [
      {
        "label": "main",
