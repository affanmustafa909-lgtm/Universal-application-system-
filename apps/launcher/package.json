{
  "name": "@platform/launcher",
  "version": "0.3.74",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:restaurant": "cross-env PLATFORM_EDITION=restaurant pnpm exec tauri dev --config src-tauri/tauri.restaurant.conf.json",
    "dev:general-store": "cross-env PLATFORM_EDITION=general-store pnpm exec tauri dev --config src-tauri/tauri.general-store.conf.json",
    "dev:pharmacy": "cross-env PLATFORM_EDITION=pharmacy pnpm exec tauri dev --config src-tauri/tauri.pharmacy.conf.json",
    "dev:distribution": "cross-env PLATFORM_EDITION=distribution pnpm exec tauri dev --config src-tauri/tauri.distribution.conf.json",
    "build": "pnpm exec tauri build",
    "build:web": "vite build",
    "build:restaurant": "node ./scripts/build-edition.mjs restaurant",
    "build:ice-cream-bar": "node ./scripts/build-edition.mjs ice-cream-bar",
    "build:general-store": "node ./scripts/build-edition.mjs general-store",
    "build:pharmacy": "node ./scripts/build-edition.mjs pharmacy",
    "build:distribution": "node ./scripts/build-edition.mjs distribution",
    "build:suite": "node ./scripts/build-edition.mjs suite",
    "build:all-editions": "pnpm build:restaurant && pnpm build:general-store && pnpm build:pharmacy && pnpm build:distribution && pnpm build:suite",
    "manifest:suite": "node ./scripts/write-update-manifest.mjs suite",
    "manifest:distribution": "node ./scripts/write-update-manifest.mjs distribution",
    "manifest:restaurant": "node ./scripts/write-update-manifest.mjs restaurant",
    "manifest:pharmacy": "node ./scripts/write-update-manifest.mjs pharmacy",
    "manifest:general-store": "node ./scripts/write-update-manifest.mjs general-store",
    "manifest:ice-cream-bar": "node ./scripts/write-update-manifest.mjs ice-cream-bar",
    "publish:desktop": "node ./scripts/publish-desktop-update.mjs",
    "publish:desktop:all": "node ./scripts/publish-desktop-update.mjs all",
    "publish:ice-cream": "node ./scripts/publish-ice-cream-update.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node ./scripts/copy-sql-wasm.mjs"
  },
  "dependencies": {
    "@platform/auth-client": "workspace:*",
    "@platform/connectivity": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/database-sqlite": "workspace:*",
    "@platform/permissions": "workspace:*",
    "@platform/shell-sdk": "workspace:*",
    "@platform/sync-engine": "workspace:*",
    "@platform/ui": "workspace:*",
    "@tanstack/react-query": "^5.64.2",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "drizzle-orm": "^0.38.4",
    "html-to-image": "^1.11.13",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.1.1",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.3.5",
    "@tauri-apps/cli": "^2.2.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.7"
  }
}
